# Dahlia .NET versions (single source of truth for the installer)
# These channels cover every TargetFramework in AleytiaFairlight/Dahlia:
#   net8.0  -> TwitchLib.Client tests/benchmarks (SDK 8)
#   net9.0  -> bot, coordinator, twitch, obs, dashboard, avatar, youtube, games, social, workflows (SDK 9)
#   net10.0 -> stage-tamagotchi-kirie + TwitchLib multi-target (SDK 10)
# netstandard2.0/2.1 needs no separate SDK. The netframework4.8 example in
# lib/Dahlia-TwitchLib is Windows-only, not in DahliaBot.sln, and is ignored.
DOTNET_CHANNELS="8.0 9.0 10.0 11.0"
DOTNET_QUALITY="GA"
